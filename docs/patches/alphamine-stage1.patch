+.mk-dark { --mk-bg: #000000; --mk-s1: #181818; --mk-s2: #1f1f1f; --mk-line: #313131; --mk-fg: #f5f5f5; --mk-mute: #9b9b9b; --mk-acc: #6fd35f; --mk-acc-fg: #000000; --mk-g1: #ffffff; --mk-g2: #9b9b9b; --ink: #f5f5f5; --profit: #6fd35f; --mk-nav: rgb(24 24 24 / 0.7); --mk-panel: rgb(0 0 0 / 0.94); color-scheme: dark; }
+.mk-light { --mk-bg: #ffffff; --mk-s1: #f6f6f6; --mk-s2: #ededed; --mk-line: #e2e2e2; --mk-fg: #111111; --mk-mute: #666666; --mk-acc: #2f8a29; --mk-acc-fg: #ffffff; --mk-g1: #000000; --mk-g2: #666666; --ink: #111111; --profit: #2f8a29; --mk-nav: rgb(255 255 255 / 0.75); --mk-panel: rgb(255 255 255 / 0.96); color-scheme: light; }
+.mk h1, .mk h2, .mk h3 { text-wrap: balance; letter-spacing: -0.02em; }
+.mk p { text-wrap: pretty; }
+.mk-wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
