# Browser + Worker (read by `vite build` / `pnpm dev`; public values, safe to ship in the bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (public). Also turn on CAPTCHA in Supabase: Authentication > Attack Protection.
VITE_TURNSTILE_SITE_KEY=

# Worker secrets: NOT here. Locally they go in .dev.vars, in production `wrangler secret put` (docs/cloudflare.md).
#   SUPABASE_SERVICE_ROLE_KEY, SCREENSHOT_SIGNING_KEY

# Only for `pnpm db:pull` / `pnpm db:generate` (drizzle-kit)
DATABASE_URL=
