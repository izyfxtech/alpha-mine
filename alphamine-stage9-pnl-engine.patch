diff --git a/supabase/functions/_shared/pnl-engine/instruments.ts b/supabase/functions/_shared/pnl-engine/instruments.ts
new file mode 100644
index 0000000..66f3623
--- /dev/null
+++ b/supabase/functions/_shared/pnl-engine/instruments.ts
@@ -0,0 +1,137 @@
+import { CRYPTO_CODES, FIAT_CODES, METAL_CODES } from './currency.ts';
+import { D, Dec, pow10, type DecimalLike } from './decimal.ts';
+import type { InstrumentKind, InstrumentSpec } from './types.ts';
+
+export class UnsupportedInstrumentError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'UnsupportedInstrumentError';
+  }
+}
+
+/** Strip broker decorations: "EURUSD.a", "EURUSDm", "EURUSD#", "eurusd_i" -> upper-case alphanumerics. */
+export function normalizeSymbol(raw: string): string {
+  return raw.toUpperCase().replace(/[^A-Z0-9]/g, '');
+}
+
+/**
+ * Fallback contract sizes. These are common conventions, NOT guarantees: brokers
+ * differ (XAUUSD is 100 oz at most, 1 oz at some; crypto CFDs vary). The engine
+ * flags any spec built from a default so the UI/reconciler can warn.
+ */
+const DEFAULT_CONTRACT_SIZE: Record<string, number> = {
+  fx: 100_000,
+  XAU: 100,
+  XAG: 5_000,
+  XPT: 100,
+  XPD: 100,
+  crypto: 1,
+};
+
+/**
+ * FX pip size from broker digits.
+ *  - 5-digit (EURUSD 1.08505) and 3-digit (USDJPY 150.123) quotes carry a
+ *    fractional pip -> pip = 10^-(digits-1)
+ *  - 4-digit and 2-digit quotes -> pip = 10^-digits
+ */
+export function deriveFxPipSize(digits: number): Dec {
+  return digits === 3 || digits === 5 ? pow10(-(digits - 1)) : pow10(-digits);
+}
+
+const isKnownCode = (c: string) => FIAT_CODES.has(c) || METAL_CODES.has(c) || CRYPTO_CODES.has(c);
+
+/**
+ * Split a normalized symbol into two KNOWN currency codes of 3 to 5 letters. Longer quote codes are
+ * tried first so BTCUSDT is BTC/USDT, not BTC/USD. Broker suffix letters after the quote are ignored.
+ */
+export function splitKnownPair(s: string): { base: string; quote: string } | null {
+  for (const bl of [3, 4, 5]) {
+    for (const ql of [5, 4, 3]) {
+      const b = s.slice(0, bl);
+      const q = s.slice(bl, bl + ql);
+      if (b.length === bl && q.length === ql && isKnownCode(b) && isKnownCode(q)) return { base: b, quote: q };
+    }
+  }
+  return null;
+}
+
+export interface InferOptions {
+  /** SYMBOL_DIGITS from the broker. Required: it is the only reliable pip-size signal. */
+  digits: number;
+  /** SYMBOL_TRADE_CONTRACT_SIZE from the broker. Strongly recommended. */
+  contractSize?: DecimalLike;
+  base?: string;
+  quote?: string;
+  /** Required for index/stock CFDs where profit currency is not derivable from the name. */
+  profitCurrency?: string;
+  kind?: InstrumentKind;
+  /** Override for exotic instruments where "pip" is non-standard. */
+  pipSize?: DecimalLike | null;
+}
+
+export function inferInstrument(rawSymbol: string, o: InferOptions): InstrumentSpec {
+  if (!Number.isInteger(o.digits) || o.digits < 0 || o.digits > 8) {
+    throw new UnsupportedInstrumentError(`digits must be an integer 0..8, got ${o.digits}`);
+  }
+  const s = normalizeSymbol(rawSymbol);
+  const split = splitKnownPair(s);
+  // Provisional codes, used only to classify. Opaque CFD/index symbols get real values below.
+  let base = (o.base ?? split?.base ?? s.slice(0, 3)).toUpperCase();
+  let quote = (o.quote ?? split?.quote ?? s.slice(3, 6)).toUpperCase();
+
+  let kind = o.kind;
+  if (!kind) {
+    if (FIAT_CODES.has(base) && FIAT_CODES.has(quote)) kind = 'fx';
+    else if (METAL_CODES.has(base) && FIAT_CODES.has(quote)) kind = 'metal';
+    else if (CRYPTO_CODES.has(base) && (FIAT_CODES.has(quote) || CRYPTO_CODES.has(quote))) kind = 'crypto';
+    else if (o.profitCurrency) kind = 'cfd';
+    else {
+      throw new UnsupportedInstrumentError(
+        `Cannot classify "${rawSymbol}". Pass profitCurrency (and kind) explicitly.`,
+      );
+    }
+  }
+
+  if ((kind === 'cfd' || kind === 'index') && !o.profitCurrency) {
+    throw new UnsupportedInstrumentError(`${rawSymbol}: pass profitCurrency for ${kind} instruments.`);
+  }
+  // A CFD or index symbol (US500, GER40) is not a currency pair: never slice currency codes out of it.
+  if (kind === 'cfd' || kind === 'index') {
+    if (o.base === undefined) base = s;
+    if (o.quote === undefined) quote = o.profitCurrency!.toUpperCase();
+  }
+
+  const profitCurrency = (o.profitCurrency ?? quote).toUpperCase();
+
+  let contractSize: Dec;
+  let source: 'broker' | 'default';
+  if (o.contractSize !== undefined) {
+    contractSize = D(o.contractSize);
+    source = 'broker';
+  } else {
+    const fallback = kind === 'fx' ? DEFAULT_CONTRACT_SIZE['fx'] : DEFAULT_CONTRACT_SIZE[base] ?? DEFAULT_CONTRACT_SIZE[kind];
+    if (fallback === undefined) {
+      throw new UnsupportedInstrumentError(`No default contract size for ${rawSymbol}; pass contractSize.`);
+    }
+    contractSize = D(fallback);
+    source = 'default';
+  }
+  if (contractSize.lte(0)) throw new UnsupportedInstrumentError('contractSize must be > 0');
+
+  let pipSize: Dec | null;
+  if (o.pipSize !== undefined) pipSize = o.pipSize === null ? null : D(o.pipSize);
+  else pipSize = kind === 'fx' ? deriveFxPipSize(o.digits) : null;
+
+  return {
+    symbol: rawSymbol,
+    base,
+    quote,
+    profitCurrency,
+    kind,
+    digits: o.digits,
+    contractSize,
+    contractSizeSource: source,
+    pointSize: pow10(-o.digits),
+    pipSize,
+  };
+}
diff --git a/supabase/functions/_shared/pnl-engine/matching.ts b/supabase/functions/_shared/pnl-engine/matching.ts
new file mode 100644
index 0000000..b6d715e
--- /dev/null
+++ b/supabase/functions/_shared/pnl-engine/matching.ts
@@ -0,0 +1,226 @@
+/**
+ * Turning raw fills into closed trades.
+ *
+ * Hedging accounts (MT4 tickets, MT5 hedging positions) need NO matching:
+ * every position already has an id and its own deals, so use position ids.
+ *
+ * Netting accounts (MT5 netting, many futures/crypto venues, CSV exports with
+ * only executions) need a policy for which entry a partial close consumes.
+ * FIFO is the common tax/reporting default. Average-cost is what netting
+ * brokers literally carry. Choose per account and store the choice, because
+ * the two give different per-trade results (never different totals).
+ *
+ * Cost allocation: per-lot cost of a fill x lots consumed. Commission and fee
+ * follow the fill they were charged on. Swap follows the CLOSING fill (that is
+ * where MT5 books it).
+ */
+import { D, Dec, ZERO } from './decimal.ts';
+import type { ClosedTrade, InstrumentSpec, Side } from './types.ts';
+
+export interface Fill {
+  id: string;
+  side: Side;
+  lots: Dec;
+  price: Dec;
+  timeMs: number;
+  /** Signed account-currency amounts. */
+  commission?: Dec;
+  swap?: Dec;
+  fee?: Dec;
+}
+
+export interface Segment {
+  /** Direction of the position that was reduced. */
+  side: Side;
+  lots: Dec;
+  openPrice: Dec;
+  closePrice: Dec;
+  openTimeMs: number;
+  closeTimeMs: number;
+  openFillId: string;
+  closeFillId: string;
+  commission: Dec;
+  swap: Dec;
+  fee: Dec;
+}
+
+export interface OpenLot {
+  fillId: string;
+  side: Side;
+  lots: Dec;
+  price: Dec;
+  timeMs: number;
+  commissionPerLot: Dec;
+  feePerLot: Dec;
+}
+
+export interface MatchResult {
+  segments: Segment[];
+  open: OpenLot[];
+}
+
+function sortFills(fills: Fill[]): Fill[] {
+  return fills
+    .map((f, i) => ({ f, i }))
+    .sort((a, b) => a.f.timeMs - b.f.timeMs || a.i - b.i)
+    .map((x) => x.f);
+}
+
+function perLot(total: Dec | undefined, lots: Dec): Dec {
+  return total ? total.div(lots) : ZERO;
+}
+
+export function matchFifo(fills: Fill[]): MatchResult {
+  const queue: OpenLot[] = [];
+  const segments: Segment[] = [];
+
+  for (const fill of sortFills(fills)) {
+    if (!fill.lots.gt(0)) throw new RangeError(`Fill ${fill.id}: lots must be > 0`);
+    const cPer = perLot(fill.commission, fill.lots);
+    const fPer = perLot(fill.fee, fill.lots);
+    const sPer = perLot(fill.swap, fill.lots);
+    let remaining = fill.lots;
+
+    // Queue invariant: every lot in it has the same direction.
+    while (remaining.gt(0) && queue.length > 0 && queue[0]!.side !== fill.side) {
+      const lot = queue[0]!;
+      const m = Dec.min(lot.lots, remaining);
+      segments.push({
+        side: lot.side,
+        lots: m,
+        openPrice: lot.price,
+        closePrice: fill.price,
+        openTimeMs: lot.timeMs,
+        closeTimeMs: fill.timeMs,
+        openFillId: lot.fillId,
+        closeFillId: fill.id,
+        commission: lot.commissionPerLot.times(m).plus(cPer.times(m)),
+        fee: lot.feePerLot.times(m).plus(fPer.times(m)),
+        swap: sPer.times(m),
+      });
+      lot.lots = lot.lots.minus(m);
+      remaining = remaining.minus(m);
+      if (lot.lots.isZero()) queue.shift();
+    }
+
+    if (remaining.gt(0)) {
+      queue.push({
+        fillId: fill.id,
+        side: fill.side,
+        lots: remaining,
+        price: fill.price,
+        timeMs: fill.timeMs,
+        commissionPerLot: cPer,
+        feePerLot: fPer,
+      });
+    }
+  }
+  return { segments, open: queue };
+}
+
+export function matchAverage(fills: Fill[]): MatchResult {
+  const segments: Segment[] = [];
+  let pos: {
+    side: Side;
+    lots: Dec;
+    avg: Dec;
+    commissionTotal: Dec;
+    feeTotal: Dec;
+    timeMs: number;
+    fillId: string;
+  } | null = null;
+
+  for (const fill of sortFills(fills)) {
+    if (!fill.lots.gt(0)) throw new RangeError(`Fill ${fill.id}: lots must be > 0`);
+    const cPer = perLot(fill.commission, fill.lots);
+    const fPer = perLot(fill.fee, fill.lots);
+    const sPer = perLot(fill.swap, fill.lots);
+    let remaining = fill.lots;
+
+    if (pos && pos.side !== fill.side) {
+      const m = Dec.min(pos.lots, remaining);
+      const share = m.div(pos.lots);
+      const openC = pos.commissionTotal.times(share);
+      const openF = pos.feeTotal.times(share);
+      segments.push({
+        side: pos.side,
+        lots: m,
+        openPrice: pos.avg,
+        closePrice: fill.price,
+        openTimeMs: pos.timeMs,
+        closeTimeMs: fill.timeMs,
+        openFillId: pos.fillId,
+        closeFillId: fill.id,
+        commission: openC.plus(cPer.times(m)),
+        fee: openF.plus(fPer.times(m)),
+        swap: sPer.times(m),
+      });
+      pos.commissionTotal = pos.commissionTotal.minus(openC);
+      pos.feeTotal = pos.feeTotal.minus(openF);
+      pos.lots = pos.lots.minus(m);
+      remaining = remaining.minus(m);
+      if (pos.lots.isZero()) pos = null;
+    }
+
+    if (remaining.gt(0)) {
+      if (!pos) {
+        pos = {
+          side: fill.side,
+          lots: remaining,
+          avg: fill.price,
+          commissionTotal: cPer.times(remaining),
+          feeTotal: fPer.times(remaining),
+          timeMs: fill.timeMs,
+          fillId: fill.id,
+        };
+      } else {
+        pos.avg = pos.avg.times(pos.lots).plus(fill.price.times(remaining)).div(pos.lots.plus(remaining));
+        pos.lots = pos.lots.plus(remaining);
+        pos.commissionTotal = pos.commissionTotal.plus(cPer.times(remaining));
+        pos.feeTotal = pos.feeTotal.plus(fPer.times(remaining));
+      }
+    }
+  }
+
+  const open: OpenLot[] = pos
+    ? [
+        {
+          fillId: pos.fillId,
+          side: pos.side,
+          lots: pos.lots,
+          price: pos.avg,
+          timeMs: pos.timeMs,
+          commissionPerLot: pos.commissionTotal.div(pos.lots),
+          feePerLot: pos.feeTotal.div(pos.lots),
+        },
+      ]
+    : [];
+  return { segments, open };
+}
+
+/** Adapt a matched segment into the engine's input. Costs are attached only when non-zero. */
+export function segmentToClosedTrade(
+  seg: Segment,
+  spec: InstrumentSpec,
+  accountCurrency: string,
+  id: string,
+): ClosedTrade {
+  const broker: NonNullable<ClosedTrade['broker']> = {};
+  if (!seg.commission.isZero()) broker.commission = seg.commission;
+  if (!seg.swap.isZero()) broker.swap = seg.swap;
+  if (!seg.fee.isZero()) broker.fee = seg.fee;
+  return {
+    id,
+    spec,
+    side: seg.side,
+    lots: seg.lots,
+    openPrice: seg.openPrice,
+    closePrice: seg.closePrice,
+    openTimeMs: seg.openTimeMs,
+    closeTimeMs: seg.closeTimeMs,
+    accountCurrency,
+    ...(Object.keys(broker).length > 0 ? { broker } : {}),
+  };
+}
+
+export { D };
diff --git a/supabase/functions/_shared/pnl-engine/rates/frankfurter.ts b/supabase/functions/_shared/pnl-engine/rates/frankfurter.ts
new file mode 100644
index 0000000..2399662
--- /dev/null
+++ b/supabase/functions/_shared/pnl-engine/rates/frankfurter.ts
@@ -0,0 +1,118 @@
+import { D } from '../decimal.ts';
+import { addDaysIso, ecbFixingUtcMs, isoDateUtc, isWeekendIso } from '../time.ts';
+import { DEFAULT_TIMEOUT_MS, defaultFetch, isRetryable, sleep, type FetchLike } from './http.ts';
+import { ProviderError, type RateObservation, type RateProvider } from './types.ts';
+
+/**
+ * ECB euro foreign exchange reference rates via the Frankfurter API (v2).
+ *
+ * VERIFIED against the live API (Oct 2026):
+ *   GET {base}/v2/rate/{BASE}/{QUOTE}?date=YYYY-MM-DD&providers=ECB
+ *   -> {"date":"2026-10-23","base":"USD","quote":"JPY","rate":156.8}
+ *
+ * What these rates are: one fixing per TARGET business day (~16:00 CET).
+ * Fine for: reporting, EOD valuation, backfilling when nothing better exists.
+ * Not fine for: intraday-accurate conversion. The error budget is a day's FX
+ * move on the quote currency (typically 0.3-0.8% for majors; can be several
+ * percent for volatile quote currencies). Use it as the LAST fallback and
+ * label results with kind 'daily-fix' so the UI can show an "approximate" badge.
+ *
+ * Only ~30 currencies are covered; unsupported pairs return null.
+ */
+export class FrankfurterProvider implements RateProvider {
+  readonly name = 'ecb-fix';
+  /** Covers a long weekend plus a TARGET holiday. */
+  readonly maxStalenessMs = 6 * 24 * 3600 * 1000;
+
+  private readonly baseUrl: string;
+  private readonly fetchImpl: FetchLike;
+  private readonly provider: string;
+  private readonly maxRetries: number;
+  private readonly timeoutMs: number;
+  private readonly sleepFn: (ms: number) => Promise<void>;
+  private readonly cache = new Map<string, { date: string; rate: number } | null>();
+
+  constructor(
+    o: {
+      baseUrl?: string;
+      fetchImpl?: FetchLike;
+      /** Frankfurter blends many central banks by default; pin to ECB for a single auditable source. */
+      provider?: string;
+      maxRetries?: number;
+      /** Per request timeout. Default 10s. */
+      timeoutMs?: number;
+      sleep?: (ms: number) => Promise<void>;
+    } = {},
+  ) {
+    this.baseUrl = (o.baseUrl ?? 'https://api.frankfurter.dev').replace(/\/$/, '');
+    this.fetchImpl = o.fetchImpl ?? defaultFetch;
+    this.provider = o.provider ?? 'ECB';
+    this.maxRetries = o.maxRetries ?? 2;
+    this.timeoutMs = o.timeoutMs ?? DEFAULT_TIMEOUT_MS;
+    this.sleepFn = o.sleep ?? sleep;
+  }
+
+  async get(base: string, quote: string, atMs: number): Promise<RateObservation | null> {
+    // Latest business day whose fixing has already happened at `atMs`.
+    let date = isoDateUtc(atMs);
+    if (atMs < ecbFixingUtcMs(date)) date = addDaysIso(date, -1);
+    while (isWeekendIso(date)) date = addDaysIso(date, -1);
+
+    for (let attempt = 0; attempt < 8; attempt++) {
+      const row = await this.fetchDate(base, quote, date);
+      if (row) {
+        const observedAtMs = ecbFixingUtcMs(row.date);
+        if (observedAtMs <= atMs) {
+          return {
+            base,
+            quote,
+            rate: D(row.rate),
+            observedAtMs,
+            source: this.name,
+            kind: 'daily-fix',
+            side: 'mid',
+          };
+        }
+      }
+      date = addDaysIso(date, -1);
+      while (isWeekendIso(date)) date = addDaysIso(date, -1);
+    }
+    return null;
+  }
+
+  private async fetchDate(base: string, quote: string, date: string): Promise<{ date: string; rate: number } | null> {
+    const key = `${base}/${quote}/${date}`;
+    if (this.cache.has(key)) return this.cache.get(key)!;
+
+    const url = `${this.baseUrl}/v2/rate/${base}/${quote}?date=${date}&providers=${this.provider}`;
+    for (let attempt = 0; ; attempt++) {
+      let res;
+      try {
+        res = await this.fetchImpl(url, { signal: AbortSignal.timeout(this.timeoutMs) });
+      } catch (err) {
+        if (attempt >= this.maxRetries) throw new ProviderError(this.name, `network error for ${url}`, err);
+        await this.sleepFn(250 * 2 ** attempt);
+        continue;
+      }
+      if (res.ok) {
+        const body = (await res.json()) as { date?: unknown; rate?: unknown };
+        if (typeof body.date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(body.date) && typeof body.rate === 'number' && body.rate > 0) {
+          const row = { date: body.date, rate: body.rate };
+          this.cache.set(key, row);
+          return row;
+        }
+        throw new ProviderError(this.name, `unexpected response shape from ${url}`);
+      }
+      if (res.status === 404 || res.status === 422) {
+        // Unknown pair or no data for this date: cache the negative so we do not hammer the API.
+        this.cache.set(key, null);
+        return null;
+      }
+      if (isRetryable(res.status) && attempt < this.maxRetries) {
+        await this.sleepFn(250 * 2 ** attempt);
+        continue;
+      }
+      throw new ProviderError(this.name, `HTTP ${res.status} for ${url}`);
+    }
+  }
+}
diff --git a/supabase/functions/_shared/pnl-engine/rates/http.ts b/supabase/functions/_shared/pnl-engine/rates/http.ts
new file mode 100644
index 0000000..d7a8c1d
--- /dev/null
+++ b/supabase/functions/_shared/pnl-engine/rates/http.ts
@@ -0,0 +1,21 @@
+/** Minimal fetch surface so providers can be unit-tested with a stub and no network. */
+export interface HttpResponse {
+  ok: boolean;
+  status: number;
+  json(): Promise<unknown>;
+}
+export type FetchLike = (
+  url: string,
+  init?: { headers?: Record<string, string>; signal?: AbortSignal },
+) => Promise<HttpResponse>;
+
+/** Hard ceiling for any single provider request. A hung socket must not stall an import. */
+export const DEFAULT_TIMEOUT_MS = 10_000;
+
+export const defaultFetch: FetchLike = (url, init) =>
+  fetch(url, { ...init, signal: init?.signal ?? AbortSignal.timeout(DEFAULT_TIMEOUT_MS) });
+
+export const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
+
+/** True for responses worth retrying: rate-limit and transient server errors. */
+export const isRetryable = (status: number) => status === 429 || (status >= 500 && status <= 599);
diff --git a/supabase/functions/_shared/pnl-engine/rates/implied.ts b/supabase/functions/_shared/pnl-engine/rates/implied.ts
new file mode 100644
index 0000000..89e9cec
--- /dev/null
+++ b/supabase/functions/_shared/pnl-engine/rates/implied.ts
@@ -0,0 +1,105 @@
+import { D, Dec, type DecimalLike } from '../decimal.ts';
+import type { InstrumentSpec, Side } from '../types.ts';
+import type { RateObservation, RateProvider } from './types.ts';
+
+export interface ImpliedRateInput {
+  spec: InstrumentSpec;
+  side: Side;
+  lots: DecimalLike;
+  openPrice: DecimalLike;
+  closePrice: DecimalLike;
+  /** Broker's GROSS profit for the trade in account currency (MT5 DEAL_PROFIT; MT4 OrderProfit()). Excludes swap/commission. */
+  brokerProfit: DecimalLike;
+  accountCurrency: string;
+  closeTimeMs: number;
+  source: string;
+  /** Below this absolute profit the broker's 2-dp rounding makes the back-solved rate too noisy. Default 5 account units (<= ~0.1% error). */
+  minAbsProfit?: DecimalLike;
+}
+
+/**
+ * Back-solve the exact conversion rate the broker applied:
+ *
+ *   brokerProfit(account) = priceDelta * units * rate(profitCcy -> account)
+ *   =>  rate = brokerProfit / (priceDelta * units)
+ *
+ * This is the most accurate rate source available because it IS the broker's
+ * number, at the broker's timestamp, with the broker's spread baked in, and it
+ * costs nothing. Returns null when the trade teaches us nothing (profit already
+ * in account currency, zero move, or too small to back-solve cleanly).
+ */
+export function deriveImpliedRate(i: ImpliedRateInput): RateObservation | null {
+  if (i.spec.profitCurrency === i.accountCurrency.toUpperCase()) return null;
+  const open = D(i.openPrice);
+  const close = D(i.closePrice);
+  const delta = i.side === 'buy' ? close.minus(open) : open.minus(close);
+  const gross = delta.times(D(i.lots)).times(i.spec.contractSize);
+  const profit = D(i.brokerProfit);
+  const floor = D(i.minAbsProfit ?? 5);
+  if (gross.isZero() || profit.abs().lt(floor)) return null;
+  const rate = profit.div(gross);
+  if (!rate.isFinite() || rate.lte(0)) return null; // sign mismatch = bad data, learn nothing
+  return {
+    base: i.spec.profitCurrency,
+    quote: i.accountCurrency.toUpperCase(),
+    rate,
+    observedAtMs: i.closeTimeMs,
+    source: i.source,
+    kind: 'implied',
+    side: 'unspecified',
+  };
+}
+
+/**
+ * Rates learned from the broker's own booked trades, scoped to ONE broker
+ * account (different brokers apply different conversion quotes).
+ *
+ * In production, back this with a table (see the plan's SQL) and a
+ * binary-search/index lookup; the in-memory version here is the reference.
+ */
+export class ImpliedRateProvider implements RateProvider {
+  readonly name: string;
+  readonly maxStalenessMs: number;
+  private readonly series = new Map<string, RateObservation[]>();
+
+  constructor(opts: { scope: string; maxStalenessMs?: number }) {
+    this.name = `implied:${opts.scope}`;
+    // 30 min default: conversion rates drift ~0.1-0.3% in that window on majors.
+    this.maxStalenessMs = opts.maxStalenessMs ?? 30 * 60_000;
+  }
+
+  record(obs: RateObservation): void {
+    const key = `${obs.base}/${obs.quote}`;
+    const arr = this.series.get(key) ?? [];
+    // keep sorted by time; insertion is O(n) but trades arrive roughly in order
+    let idx = arr.length;
+    while (idx > 0 && arr[idx - 1]!.observedAtMs > obs.observedAtMs) idx--;
+    arr.splice(idx, 0, obs);
+    this.series.set(key, arr);
+  }
+
+  async get(base: string, quote: string, atMs: number): Promise<RateObservation | null> {
+    const arr = this.series.get(`${base}/${quote}`);
+    if (!arr || arr.length === 0) return null;
+    let lo = 0;
+    let hi = arr.length - 1;
+    let best = -1;
+    while (lo <= hi) {
+      const mid = (lo + hi) >> 1;
+      if (arr[mid]!.observedAtMs <= atMs) {
+        best = mid;
+        lo = mid + 1;
+      } else hi = mid - 1;
+    }
+    return best >= 0 ? arr[best]! : null;
+  }
+
+  /** Test/diagnostic helper. */
+  size(): number {
+    let n = 0;
+    for (const a of this.series.values()) n += a.length;
+    return n;
+  }
+}
+
+export { Dec };
diff --git a/supabase/functions/_shared/pnl-engine/rates/massive.ts b/supabase/functions/_shared/pnl-engine/rates/massive.ts
new file mode 100644
index 0000000..5ec2012
--- /dev/null
+++ b/supabase/functions/_shared/pnl-engine/rates/massive.ts
@@ -0,0 +1,145 @@
+import { D } from '../decimal.ts';
+import { DEFAULT_TIMEOUT_MS, defaultFetch, isRetryable, sleep, type FetchLike } from './http.ts';
+import { ProviderError, type RateObservation, type RateProvider } from './types.ts';
+
+const HOUR_MS = 3_600_000;
+const MINUTE_MS = 60_000;
+
+interface Bar {
+  t: number;
+  o: number;
+  c: number;
+}
+
+/**
+ * 1-minute FX bars from Massive (formerly Polygon.io).
+ *
+ * VERIFIED from Massive's API reference:
+ *   GET https://api.massive.com/v2/aggs/ticker/C:EURUSD/range/1/minute/{from}/{to}
+ *   from/to accept YYYY-MM-DD or millisecond timestamps; limit max 50000.
+ *   results[]: { o, h, l, c, v, t (bar START, unix ms), n?, vw? }
+ *   Bars are built from quoted bid/ask (not trades). A minute with no quotes has no bar.
+ *   Plans: Currencies Basic = free, EOD only, 2y history. Starter = all history (to Sep 2009).
+ *   Minute history therefore needs a paid plan; confirm current terms before relying on it.
+ *
+ * NOT confirmed by the docs: whether bar prices are bid, ask or mid. Side is
+ * therefore labelled 'unspecified'. If side matters to you, validate against a
+ * broker feed once and record the finding.
+ *
+ * No look-ahead rule. For an instant `at` inside bar B (start t, t <= at < t+60s)
+ * we use B.open: the price at the start of the minute, which was knowable at
+ * `at`. If `at` is past a completed bar with no bar after it (a quote gap), we
+ * use that bar's close, observed at t+60s.
+ *
+ * Bars are fetched and cached by whole UTC hour, which amortises API calls
+ * across trades. The current (incomplete) hour is never cached.
+ */
+export class MassiveMinuteProvider implements RateProvider {
+  readonly name = 'massive-1m';
+  readonly maxStalenessMs: number;
+
+  private readonly apiKey: string;
+  private readonly baseUrl: string;
+  private readonly fetchImpl: FetchLike;
+  private readonly auth: 'header' | 'query';
+  private readonly nowFn: () => number;
+  private readonly maxRetries: number;
+  private readonly timeoutMs: number;
+  private readonly sleepFn: (ms: number) => Promise<void>;
+  private readonly hourCache = new Map<string, Bar[]>();
+
+  constructor(o: {
+    apiKey: string;
+    baseUrl?: string;
+    fetchImpl?: FetchLike;
+    /** 'header' sends Authorization: Bearer; 'query' sends ?apiKey=. Docs show query; Bearer is also accepted by the Polygon-compatible API. */
+    auth?: 'header' | 'query';
+    maxStalenessMs?: number;
+    now?: () => number;
+    maxRetries?: number;
+    /** Per request timeout. Default 10s. */
+    timeoutMs?: number;
+    sleep?: (ms: number) => Promise<void>;
+  }) {
+    if (!o.apiKey) throw new Error('MassiveMinuteProvider: apiKey required');
+    this.apiKey = o.apiKey;
+    this.baseUrl = (o.baseUrl ?? 'https://api.massive.com').replace(/\/$/, '');
+    this.fetchImpl = o.fetchImpl ?? defaultFetch;
+    this.auth = o.auth ?? 'header';
+    this.maxStalenessMs = o.maxStalenessMs ?? 15 * MINUTE_MS;
+    this.nowFn = o.now ?? Date.now;
+    this.maxRetries = o.maxRetries ?? 2;
+    this.timeoutMs = o.timeoutMs ?? DEFAULT_TIMEOUT_MS;
+    this.sleepFn = o.sleep ?? sleep;
+  }
+
+  async get(base: string, quote: string, atMs: number): Promise<RateObservation | null> {
+    const ticker = `C:${base}${quote}`;
+    const lastHour = Math.floor(atMs / HOUR_MS) * HOUR_MS;
+    const hoursBack = Math.ceil(this.maxStalenessMs / HOUR_MS) + 1;
+
+    for (let k = 0; k <= hoursBack; k++) {
+      const bars = await this.hourBars(ticker, lastHour - k * HOUR_MS);
+      // bars are ascending; find the last bar starting at or before atMs
+      let pick: Bar | undefined;
+      for (let i = bars.length - 1; i >= 0; i--) {
+        if (bars[i]!.t <= atMs) {
+          pick = bars[i];
+          break;
+        }
+      }
+      if (!pick) continue;
+      const inside = atMs - pick.t < MINUTE_MS;
+      const observedAtMs = inside ? pick.t : pick.t + MINUTE_MS;
+      if (atMs - observedAtMs > this.maxStalenessMs) return null;
+      return {
+        base,
+        quote,
+        rate: D(inside ? pick.o : pick.c),
+        observedAtMs,
+        source: this.name,
+        kind: 'minute',
+        side: 'unspecified',
+      };
+    }
+    return null;
+  }
+
+  private async hourBars(ticker: string, hourStart: number): Promise<Bar[]> {
+    const key = `${ticker}@${hourStart}`;
+    const cached = this.hourCache.get(key);
+    if (cached) return cached;
+
+    const url =
+      `${this.baseUrl}/v2/aggs/ticker/${ticker}/range/1/minute/${hourStart}/${hourStart + HOUR_MS - 1}` +
+      `?adjusted=true&sort=asc&limit=50000` +
+      (this.auth === 'query' ? `&apiKey=${encodeURIComponent(this.apiKey)}` : '');
+    const headers: Record<string, string> = this.auth === 'header' ? { Authorization: `Bearer ${this.apiKey}` } : {};
+
+    for (let attempt = 0; ; attempt++) {
+      let res;
+      try {
+        res = await this.fetchImpl(url, { headers, signal: AbortSignal.timeout(this.timeoutMs) });
+      } catch (err) {
+        if (attempt >= this.maxRetries) throw new ProviderError(this.name, `network error for ${ticker}`, err);
+        await this.sleepFn(500 * 2 ** attempt);
+        continue;
+      }
+      if (res.ok) {
+        const body = (await res.json()) as { results?: Array<{ t?: number; o?: number; c?: number }> };
+        const bars: Bar[] = (body.results ?? [])
+          .filter((r): r is Bar => typeof r.t === 'number' && typeof r.o === 'number' && typeof r.c === 'number')
+          .sort((a, b) => a.t - b.t);
+        if (hourStart + HOUR_MS <= this.nowFn()) this.hourCache.set(key, bars); // only complete hours
+        return bars;
+      }
+      if (res.status === 404) return [];
+      if (isRetryable(res.status) && attempt < this.maxRetries) {
+        await this.sleepFn(500 * 2 ** attempt);
+        continue;
+      }
+      // 401/403 = key/plan problem: surface loudly, do not paper over with an empty answer.
+      throw new ProviderError(this.name, `HTTP ${res.status} for ${ticker}`);
+    }
+  }
+}
diff --git a/supabase/functions/_shared/pnl-engine/rates/resolver.ts b/supabase/functions/_shared/pnl-engine/rates/resolver.ts
new file mode 100644
index 0000000..127fb2c
--- /dev/null
+++ b/supabase/functions/_shared/pnl-engine/rates/resolver.ts
@@ -0,0 +1,108 @@
+import { ONE } from '../decimal.ts';
+import type { RateObservation, RateProvider } from './types.ts';
+
+export interface ResolverOptions {
+  /** Priority order: most accurate first. The first provider able to price the pair wins. */
+  providers: RateProvider[];
+  /**
+   * Intermediate currencies for triangulation, tried in order. USD first
+   * (deepest liquidity), then EUR. A currency equal to either endpoint is skipped.
+   */
+  pivots?: string[];
+  /** Called when a provider throws (network, auth, quota). The resolver then falls through to the next provider. */
+  onProviderError?: (provider: string, err: unknown) => void;
+}
+
+const sameInstant = (a: number, b: number) => a === b;
+
+/**
+ * Answers: "what is 1 FROM worth in TO at instant t?"
+ *
+ * Order of attempts, per provider (providers are NOT mixed within one answer,
+ * so both legs of a triangulation share a timestamp basis):
+ *   1. identity                  (FROM === TO)
+ *   2. direct pair   FROM/TO
+ *   3. inverse pair  TO/FROM  -> 1/rate
+ *   4. triangulation FROM -> pivot -> TO, each leg direct or inverse
+ */
+export class RateResolver {
+  private readonly providers: RateProvider[];
+  private readonly pivots: string[];
+  private readonly onErr: (provider: string, err: unknown) => void;
+
+  constructor(opts: ResolverOptions) {
+    this.providers = opts.providers;
+    this.pivots = (opts.pivots ?? ['USD', 'EUR']).map((c) => c.toUpperCase());
+    this.onErr = opts.onProviderError ?? (() => undefined);
+  }
+
+  async resolve(from: string, to: string, atMs: number): Promise<RateObservation | null> {
+    const f = from.toUpperCase();
+    const t = to.toUpperCase();
+    if (f === t) {
+      return { base: f, quote: t, rate: ONE, observedAtMs: atMs, source: 'identity', kind: 'derived', side: 'mid' };
+    }
+    for (const p of this.providers) {
+      try {
+        const hit = await this.viaProvider(p, f, t, atMs);
+        if (hit) return hit;
+      } catch (err) {
+        this.onErr(p.name, err);
+      }
+    }
+    return null;
+  }
+
+  private async viaProvider(p: RateProvider, f: string, t: string, atMs: number): Promise<RateObservation | null> {
+    const direct = await this.directOrInverse(p, f, t, atMs);
+    if (direct) return direct;
+
+    for (const pivot of this.pivots) {
+      if (pivot === f || pivot === t) continue;
+      const leg1 = await this.directOrInverse(p, f, pivot, atMs);
+      if (!leg1) continue;
+      const leg2 = await this.directOrInverse(p, pivot, t, atMs);
+      if (!leg2) continue;
+      return {
+        base: f,
+        quote: t,
+        rate: leg1.rate.times(leg2.rate),
+        // A chain is only as fresh as its stalest link.
+        observedAtMs: Math.min(leg1.observedAtMs, leg2.observedAtMs),
+        source: p.name,
+        kind: 'derived',
+        side: leg1.side === leg2.side ? leg1.side : 'unspecified',
+        lineage: [leg1, leg2],
+      };
+    }
+    return null;
+  }
+
+  private async directOrInverse(p: RateProvider, f: string, t: string, atMs: number): Promise<RateObservation | null> {
+    const d = await this.fetchChecked(p, f, t, atMs);
+    if (d) return d;
+    const i = await this.fetchChecked(p, t, f, atMs);
+    if (!i) return null;
+    return {
+      base: f,
+      quote: t,
+      rate: ONE.div(i.rate),
+      observedAtMs: i.observedAtMs,
+      source: i.source,
+      kind: 'derived',
+      // Inverting swaps bid<->ask.
+      side: i.side === 'bid' ? 'ask' : i.side === 'ask' ? 'bid' : i.side,
+      lineage: [i],
+    };
+  }
+
+  /** Enforce the provider contract: positive rate, no look-ahead, inside staleness window. */
+  private async fetchChecked(p: RateProvider, b: string, q: string, atMs: number): Promise<RateObservation | null> {
+    const o = await p.get(b, q, atMs);
+    if (!o) return null;
+    if (!o.rate.isFinite() || o.rate.lte(0)) return null;
+    if (o.observedAtMs > atMs && !sameInstant(o.observedAtMs, atMs)) return null; // look-ahead
+    if (atMs - o.observedAtMs > p.maxStalenessMs) return null;
+    return o;
+  }
+}
diff --git a/supabase/functions/_shared/pnl-engine/rates/types.ts b/supabase/functions/_shared/pnl-engine/rates/types.ts
new file mode 100644
index 0000000..825c51c
--- /dev/null
+++ b/supabase/functions/_shared/pnl-engine/rates/types.ts
@@ -0,0 +1,57 @@
+import type { Dec } from '../decimal.ts';
+
+/**
+ * Where an observation sits on the accuracy ladder (best first):
+ *  implied   - back-solved from the broker's own booked profit (exactly what the broker used)
+ *  tick      - tick/quote-level market data
+ *  minute    - 1-minute bars
+ *  daily-fix - once-a-day central-bank reference rate
+ *  derived   - inverted or triangulated from the above
+ */
+export type RateKind = 'implied' | 'tick' | 'minute' | 'daily-fix' | 'derived';
+export type RateSide = 'mid' | 'bid' | 'ask' | 'unspecified';
+
+/**
+ * A rate observation: 1 unit of `base` is worth `rate` units of `quote`,
+ * valid as of `observedAtMs` (UTC). Observations are immutable facts; persist
+ * the one used for every conversion so historical P&L is reproducible and
+ * auditable even if a vendor later revises its data.
+ */
+export interface RateObservation {
+  base: string;
+  quote: string;
+  rate: Dec;
+  observedAtMs: number;
+  source: string;
+  kind: RateKind;
+  side: RateSide;
+  /** For derived rates: the observations this one was built from. */
+  lineage?: RateObservation[];
+}
+
+export interface RateProvider {
+  readonly name: string;
+  /**
+   * Oldest observation (relative to the requested instant) this provider may
+   * answer with. Beyond it, "no rate" is the honest answer: a 3-day-old rate
+   * silently applied to a minute-resolution trade is worse than a flagged gap.
+   */
+  readonly maxStalenessMs: number;
+  /**
+   * Latest observation at or BEFORE `atMs` for 1 `base` in `quote`.
+   * Must never look ahead of `atMs`. Return null if the pair is unsupported
+   * or no observation exists inside the staleness window.
+   */
+  get(base: string, quote: string, atMs: number): Promise<RateObservation | null>;
+}
+
+export class ProviderError extends Error {
+  constructor(
+    public readonly provider: string,
+    message: string,
+    public override readonly cause?: unknown,
+  ) {
+    super(`[${provider}] ${message}`);
+    this.name = 'ProviderError';
+  }
+}
diff --git a/supabase/functions/_shared/pnl-engine/reconcile.ts b/supabase/functions/_shared/pnl-engine/reconcile.ts
new file mode 100644
index 0000000..5cb5799
--- /dev/null
+++ b/supabase/functions/_shared/pnl-engine/reconcile.ts
@@ -0,0 +1,119 @@
+import { D, Dec, pow10 } from './decimal.ts';
+import { minorUnits } from './currency.ts';
+import type { RateObservation } from './rates/types.ts';
+
+export type ReconStatus = 'OK' | 'WARN' | 'MISMATCH';
+
+export interface Tolerance {
+  /** Flat allowance in account currency (covers the broker's own rounding). */
+  absolute: Dec;
+  /** Fraction of |imported| (covers conversion-rate differences between sources). */
+  relative: Dec;
+}
+
+export interface Reconciliation {
+  status: ReconStatus;
+  imported: Dec;
+  computed: Dec | null;
+  diff: Dec | null;
+  allowed: Dec;
+  /** Ordered, human-readable hypotheses for a failed match. Surface these in the UI. */
+  diagnosis: string[];
+  /** Rate source the independent calculation relied on. */
+  rateSource: string | null;
+}
+
+/**
+ * Relative tolerance by rate quality. The broker converted at its own quote at
+ * its own instant; our independent calculation can only approximate that, and
+ * how closely depends on the source:
+ *   identity  - no conversion involved: only broker rounding differs
+ *   tick/minute/implied - sub-0.5% on majors
+ *   daily-fix - a whole day's move in the quote currency
+ * A chain (inversion/triangulation) is as loose as its loosest leg.
+ */
+export function relativeToleranceFor(obs: RateObservation | null): Dec {
+  if (!obs) return D('0.003');
+  if (obs.source === 'identity') return D('0.0001');
+  if (obs.lineage && obs.lineage.length > 0) {
+    return obs.lineage.map(relativeToleranceFor).reduce((a, b) => (a.gt(b) ? a : b));
+  }
+  switch (obs.kind) {
+    case 'daily-fix':
+      return D('0.015');
+    case 'tick':
+      return D('0.002');
+    case 'minute':
+    case 'implied':
+    case 'derived':
+      return D('0.003');
+  }
+}
+
+/** Absolute floor: five minor units of the account currency (0.05 USD, 5 JPY, 0.005 BHD). */
+export function absoluteToleranceFor(accountCurrency: string): Dec {
+  return D(5).times(pow10(-minorUnits(accountCurrency)));
+}
+
+export function reconcile(imported: Dec, computed: Dec | null, tol: Tolerance, rateSource: string | null = null): Reconciliation {
+  const allowed = tol.absolute.plus(tol.relative.times(imported.abs()));
+  if (computed === null) {
+    return {
+      status: 'WARN',
+      imported,
+      computed: null,
+      diff: null,
+      allowed,
+      diagnosis: ['No independent rate available: broker figure stored unverified.'],
+      rateSource,
+    };
+  }
+  const diff = imported.minus(computed);
+  const absDiff = diff.abs();
+  let status: ReconStatus;
+  if (absDiff.lte(allowed)) status = 'OK';
+  else if (absDiff.lte(allowed.times(3))) status = 'WARN';
+  else status = 'MISMATCH';
+  return {
+    status,
+    imported,
+    computed,
+    diff,
+    allowed,
+    diagnosis: status === 'OK' ? [] : diagnose(imported, computed),
+    rateSource,
+  };
+}
+
+/** Heuristics that turn "numbers differ" into "here is probably why". */
+export function diagnose(imported: Dec, computed: Dec): string[] {
+  const out: string[] = [];
+  if (imported.isZero()) {
+    out.push('Broker profit is zero: this may be an opening deal, a balance operation, or a zero-move trade.');
+    return out;
+  }
+  if (computed.isZero()) {
+    out.push('Computed result is zero but broker booked a result: check open/close prices and symbol mapping.');
+    return out;
+  }
+  const ratio = imported.div(computed);
+  if (ratio.isNegative()) {
+    out.push('Opposite signs: trade side (buy/sell) is probably reversed.');
+  }
+  const abs = ratio.abs();
+  const log = Math.log10(abs.toNumber());
+  const nearest = Math.round(log);
+  if (nearest !== 0 && Math.abs(log - nearest) < 0.01) {
+    out.push(
+      `Ratio is ~10^${nearest}: contract size, lot unit (0.01 vs 1.0) or pip/digit scaling is off by a power of ten.`,
+    );
+  } else if (abs.gt('0.85') && abs.lt('1.15')) {
+    out.push('Within ~15% but outside tolerance: conversion rate differs (stale source, wrong timestamp/timezone, or broker markup).');
+  } else if (abs.gt('0.4') && abs.lt('2.5')) {
+    out.push('Off by a factor between 0.4x and 2.5x: check lots, partial-close allocation, and whether the broker row is a full or partial close.');
+  }
+  if (out.length === 0) out.push('Unexplained: verify symbol mapping, contract size, lot units and timestamps.');
+  return out;
+}
+
+export { Dec };
diff --git a/supabase/functions/_shared/pnl-engine/time.ts b/supabase/functions/_shared/pnl-engine/time.ts
new file mode 100644
index 0000000..8a75c9f
--- /dev/null
+++ b/supabase/functions/_shared/pnl-engine/time.ts
@@ -0,0 +1,101 @@
+/**
+ * Time handling. Rate lookups are only as good as the timestamp you feed them,
+ * and MetaTrader reports SERVER time, not UTC. A 2-3 hour error here means
+ * you convert a Friday-evening close at a Monday rate.
+ */
+
+/** How the broker's server clock relates to UTC. */
+export type ServerTz =
+  | { kind: 'fixed'; offsetMinutes: number }
+  /** The dominant FX convention: GMT+2 in winter, GMT+3 during US DST ("New York close" servers). */
+  | { kind: 'ny-close' }
+  /** Server follows an IANA zone's own DST rules, e.g. "Europe/Athens" (EET/EEST, EU DST). */
+  | { kind: 'iana'; zone: string };
+
+const dtfCache = new Map<string, Intl.DateTimeFormat>();
+
+/** Offset of `zone` from UTC (ms, positive east) at the given UTC instant. */
+export function zoneOffsetMs(zone: string, utcMs: number): number {
+  let f = dtfCache.get(zone);
+  if (!f) {
+    f = new Intl.DateTimeFormat('en-US', {
+      timeZone: zone,
+      hourCycle: 'h23',
+      year: 'numeric',
+      month: '2-digit',
+      day: '2-digit',
+      hour: '2-digit',
+      minute: '2-digit',
+      second: '2-digit',
+    });
+    dtfCache.set(zone, f);
+  }
+  const p: Record<string, number> = {};
+  for (const part of f.formatToParts(new Date(utcMs))) {
+    if (part.type !== 'literal') p[part.type] = Number(part.value);
+  }
+  const asUtc = Date.UTC(p['year']!, p['month']! - 1, p['day']!, p['hour']!, p['minute']!, p['second']!);
+  return asUtc - Math.floor(utcMs / 1000) * 1000;
+}
+
+/** Wall-clock time in an IANA zone (expressed as if it were UTC ms) -> true UTC ms. */
+export function zoneWallToUtcMs(zone: string, wallMs: number): number {
+  let utc = wallMs - zoneOffsetMs(zone, wallMs);
+  utc = wallMs - zoneOffsetMs(zone, utc); // second pass settles DST boundaries
+  return utc;
+}
+
+/** n-th Sunday (1-based) of a month, as 00:00 UTC ms. monthIdx is 0-based. */
+function nthSundayMs(year: number, monthIdx: number, n: number): number {
+  const firstDow = new Date(Date.UTC(year, monthIdx, 1)).getUTCDay();
+  const firstSunday = 1 + ((7 - firstDow) % 7);
+  return Date.UTC(year, monthIdx, firstSunday + 7 * (n - 1));
+}
+
+/**
+ * Convert a MetaTrader server timestamp to UTC epoch ms.
+ *
+ * `serverWallMs` is the number MT gives you: wall-clock server time encoded
+ * as if it were UTC (MT5 history times, MT4 OrderOpenTime() etc.).
+ *
+ * 'ny-close' note: US DST starts the 2nd Sunday of March and ends the 1st
+ * Sunday of November. FX is closed across the real switch instant, and the
+ * Sunday-evening reopen is already on the new regime, so treating the whole
+ * switch Sunday as the new regime is exact for every tradable moment.
+ */
+export function serverWallToUtcMs(serverWallMs: number, tz: ServerTz): number {
+  switch (tz.kind) {
+    case 'fixed':
+      return serverWallMs - tz.offsetMinutes * 60_000;
+    case 'iana':
+      return zoneWallToUtcMs(tz.zone, serverWallMs);
+    case 'ny-close': {
+      const y = new Date(serverWallMs).getUTCFullYear();
+      const dstStart = nthSundayMs(y, 2, 2);
+      const dstEnd = nthSundayMs(y, 10, 1);
+      const dst = serverWallMs >= dstStart && serverWallMs < dstEnd;
+      return serverWallMs - (dst ? 180 : 120) * 60_000;
+    }
+  }
+}
+
+/** ECB reference rates are published ~16:00 Central European Time on TARGET business days. */
+export function ecbFixingUtcMs(dateIso: string): number {
+  const [y, m, d] = dateIso.split('-').map(Number) as [number, number, number];
+  return zoneWallToUtcMs('Europe/Berlin', Date.UTC(y, m - 1, d, 16, 0, 0));
+}
+
+export function isoDateUtc(ms: number): string {
+  return new Date(ms).toISOString().slice(0, 10);
+}
+
+export function addDaysIso(dateIso: string, days: number): string {
+  const [y, m, d] = dateIso.split('-').map(Number) as [number, number, number];
+  return isoDateUtc(Date.UTC(y, m - 1, d + days));
+}
+
+export function isWeekendIso(dateIso: string): boolean {
+  const [y, m, d] = dateIso.split('-').map(Number) as [number, number, number];
+  const dow = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
+  return dow === 0 || dow === 6;
+}
diff --git a/supabase/functions/_shared/pnl-engine/types.ts b/supabase/functions/_shared/pnl-engine/types.ts
new file mode 100644
index 0000000..6107806
--- /dev/null
+++ b/supabase/functions/_shared/pnl-engine/types.ts
@@ -0,0 +1,67 @@
+import type { Dec } from './decimal.ts';
+
+export type Side = 'buy' | 'sell';
+
+export type InstrumentKind = 'fx' | 'metal' | 'crypto' | 'index' | 'cfd';
+
+/**
+ * Everything the engine needs to know about a tradable symbol. For MT4/MT5
+ * accounts, populate from SymbolInfo (digits, contract size) rather than
+ * relying on defaults: contract size is per-broker.
+ */
+export interface InstrumentSpec {
+  /** Broker symbol exactly as it appears in the account, e.g. "EURUSDm". */
+  symbol: string;
+  base: string;
+  quote: string;
+  /** Currency in which the broker books raw P&L. For spot FX this is the quote currency. */
+  profitCurrency: string;
+  kind: InstrumentKind;
+  /** Decimal places in the broker's quote (5 for EURUSD, 3 for USDJPY). */
+  digits: number;
+  /** Units of base per 1.0 lot (100_000 for FX). */
+  contractSize: Dec;
+  contractSizeSource: 'broker' | 'default';
+  /** Smallest price step the broker quotes: 10^-digits. */
+  pointSize: Dec;
+  /** FX pip size. null for instruments where "pip" is not a meaningful unit. */
+  pipSize: Dec | null;
+}
+
+/** Amounts the broker reported, in ACCOUNT currency, signed (costs negative). */
+export interface BrokerReported {
+  /** Gross trading result only: MT5 DEAL_PROFIT / MT4 OrderProfit(). Excludes swap/commission/fee. */
+  profit?: Dec;
+  swap?: Dec;
+  commission?: Dec;
+  fee?: Dec;
+}
+
+/** One fully closed position (or closed segment of a position). */
+export interface ClosedTrade {
+  id: string;
+  spec: InstrumentSpec;
+  side: Side;
+  lots: Dec;
+  openPrice: Dec;
+  closePrice: Dec;
+  /** UTC epoch milliseconds. Convert broker server time first (see time.ts). */
+  openTimeMs: number;
+  closeTimeMs: number;
+  accountCurrency: string;
+  broker?: BrokerReported;
+  /** Initial stop loss, used for planned risk / R-multiple. */
+  stopLoss?: Dec;
+  takeProfit?: Dec;
+}
+
+export interface OpenPosition {
+  id: string;
+  spec: InstrumentSpec;
+  side: Side;
+  lots: Dec;
+  openPrice: Dec;
+  openTimeMs: number;
+  accountCurrency: string;
+  broker?: { swap?: Dec; commission?: Dec; fee?: Dec };
+}
diff --git a/supabase/functions/_shared/pnl-map.ts b/supabase/functions/_shared/pnl-map.ts
new file mode 100644
index 0000000..5c3b066
--- /dev/null
+++ b/supabase/functions/_shared/pnl-map.ts
@@ -0,0 +1,111 @@
+/**
+ * Pure mapping from AlphaMine rows to engine inputs. No I/O, so it is unit tested in Vitest and
+ * reused unchanged by the Edge Function.
+ */
+import { D, type ClosedTrade, inferInstrument, UnsupportedInstrumentError } from './pnl-engine/index.ts';
+
+export interface TradeRow {
+  id: string;
+  direction: 'long' | 'short';
+  entry_at: string | null;
+  exit_at: string | null;
+  entry_price: number | string | null;
+  exit_price: number | string | null;
+  quantity: number | string | null;
+  stop_loss: number | string | null;
+  take_profit: number | string | null;
+  gross_pnl: number | string | null;
+  net_pnl: number | string | null;
+  fees: number | string | null;
+  commission: number | string | null;
+  swap: number | string | null;
+  risk_amount: number | string | null;
+  source: string | null;
+  raw_symbol: string | null;
+  is_break_even: boolean | null;
+  pnl_manual: boolean | null;
+  instrument_id: string | null;
+}
+export interface InstrumentRow {
+  id: string;
+  symbol: string;
+  contract_size: number | string | null;
+  digits: number | null;
+  profit_currency: string | null;
+  kind: 'fx' | 'metal' | 'crypto' | 'index' | 'cfd' | null;
+}
+export interface JournalRow { id: string; currency: string; quantity_unit: 'lots' | 'units' | null }
+
+export type Mapped = { trade: ClosedTrade; notes: string[] } | { skip: string };
+
+const has = (v: unknown): v is number | string => v !== null && v !== undefined && v !== '';
+const decimals = (v: number | string | null) => (has(v) ? (String(v).split('.')[1] ?? '').length : 0);
+
+/** Highest price precision seen per instrument, used only when `instruments.digits` is empty. */
+export function guessDigits(rows: TradeRow[]): Map<string, number> {
+  const out = new Map<string, number>();
+  for (const r of rows) {
+    if (!r.instrument_id) continue;
+    const d = Math.max(decimals(r.entry_price), decimals(r.exit_price));
+    out.set(r.instrument_id, Math.min(8, Math.max(out.get(r.instrument_id) ?? 0, d)));
+  }
+  return out;
+}
+
+export function mapTrade(row: TradeRow, ins: InstrumentRow | undefined, journal: JournalRow, digitsGuess: Map<string, number>): Mapped {
+  if (row.pnl_manual && (row.source ?? 'manual') === 'manual') return { skip: 'P&L entered by hand is never overwritten' };
+  if (row.is_break_even) return { skip: 'marked break even' };
+  if (!has(row.entry_price) || !has(row.exit_price) || !row.entry_at || !row.exit_at) return { skip: 'trade is not closed or has no prices' };
+  if (!has(row.quantity) || Number(row.quantity) <= 0) return { skip: 'no quantity' };
+  if (!journal.quantity_unit) return { skip: 'journal quantity unit (lots or units) is not set' };
+  const symbol = row.raw_symbol ?? ins?.symbol;
+  if (!symbol) return { skip: 'no instrument symbol' };
+
+  const notes: string[] = [];
+  const own = Math.max(decimals(row.entry_price), decimals(row.exit_price));
+  const digits = Math.min(8, Math.max(2, ins?.digits ?? (ins ? digitsGuess.get(ins.id) : undefined) ?? own));
+  if (ins?.digits == null) notes.push(`price digits inferred as ${digits}`);
+
+  let spec;
+  try {
+    spec = inferInstrument(symbol, {
+      digits,
+      contractSize: has(ins?.contract_size) ? Number(ins!.contract_size) : undefined,
+      profitCurrency: ins?.profit_currency ?? undefined,
+      kind: ins?.kind ?? undefined,
+    });
+  } catch (e) {
+    // Any instrument problem (unsupported symbol, bad digits) skips this one trade, never the batch.
+    return { skip: e instanceof UnsupportedInstrumentError ? e.message : `instrument could not be resolved: ${(e as Error).message}` };
+  }
+  if (spec.contractSizeSource === 'default') notes.push(`contract size defaulted to ${spec.contractSize.toString()}`);
+
+  const qty = D(row.quantity);
+  const lots = journal.quantity_unit === 'lots' ? qty : qty.div(spec.contractSize);
+
+  // Costs. MetaTrader style columns win; otherwise AlphaMine `fees` (a positive cost) is used.
+  const broker: NonNullable<ClosedTrade['broker']> = {};
+  const imported = (row.source ?? 'manual') !== 'manual';
+  if (imported && has(row.gross_pnl)) broker.profit = D(row.gross_pnl);
+  if (has(row.commission)) broker.commission = D(row.commission);
+  if (has(row.swap)) broker.swap = D(row.swap);
+  if (!has(row.commission) && !has(row.swap) && has(row.fees) && Number(row.fees) !== 0) broker.fee = D(row.fees).neg();
+
+  return {
+    notes,
+    trade: {
+      id: row.id,
+      spec,
+      side: row.direction === 'short' ? 'sell' : 'buy',
+      lots,
+      openPrice: D(row.entry_price),
+      closePrice: D(row.exit_price),
+      openTimeMs: Date.parse(row.entry_at),
+      closeTimeMs: Date.parse(row.exit_at),
+      accountCurrency: journal.currency.toUpperCase(),
+      broker: Object.keys(broker).length ? broker : undefined,
+      stopLoss: has(row.stop_loss) ? D(row.stop_loss) : undefined,
+      takeProfit: has(row.take_profit) ? D(row.take_profit) : undefined,
+    },
+  };
+}
