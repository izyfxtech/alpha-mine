+});
+
+describe('mark-to-market', () => {
+  const pos = (side: Side) => ({
+    id: 'p1',
+    spec: eurusd,
+    side,
+    lots: D('1'),
+    openPrice: D('1.1000'),
+    openTimeMs: T0,
+    accountCurrency: 'USD',
+  });
+  const q = { bid: D('1.1010'), ask: D('1.1012') };
+
+  it('values longs at BID', async () => {
